{
  "name": "FrontDesk AI",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bullseye",

  // Minimum 4-core / 8GB RAM recommended: kind control plane (~500MB)
  // + Docker daemon (~200MB) + FrontDesk AI with ONNX/ChromaDB (~1GB) = ~2GB+
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },

  "features": {
    // Docker-in-Docker so kind can spawn cluster nodes as containers
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    },
    // kubectl + helm CLI
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "none"
    }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "forwardPorts": [8000, 9090],
  "portsAttributes": {
    "8000": { "label": "FrontDesk AI", "onAutoForward": "openBrowser" },
    "9090": { "label": "Prometheus" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // Python
        "ms-python.python",
        "ms-python.vscode-pylance",
        // Kubernetes + Docker
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-azuretools.vscode-docker",
        // YAML / shell / env files
        "redhat.vscode-yaml",
        "timonwong.shellcheck",
        "mikestead.dotenv",
        // Jinja2 templates (templates/login.html)
        "samuelcolvin.jinjahtml",
        // SQLite viewer (history.db, frontdesk_tools.db, checkpoints.db)
        "mtxr.sqliteviewer",
        // API testing
        "rangav.vscode-thunder-client",
        // Git
        "eamodio.gitlens"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.terminal.activateEnvironment": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "remoteEnv": {
    "KUBECONFIG": "/home/vscode/.kube/config",
    "SQLITE_DIR": "/shared/.sqlite"
  }
}
