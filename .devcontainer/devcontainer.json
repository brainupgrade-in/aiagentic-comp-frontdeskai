{
  "name": "FrontDesk AI",
  // Keep the Python minor in sync with Containerfile (python:3.13-slim) so the
  // app behaves the same run directly here and deployed to kind.
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",

  // Minimum 4-core / 8GB RAM recommended: kind control plane (~500MB)
  // + Docker daemon (~200MB) + FrontDesk AI with ONNX/ChromaDB (~1GB) = ~2GB+
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },

  "features": {
    // SSH server — enables `gh codespace ssh` and remote Claude Code access
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    },
    // Docker-in-Docker so kind can spawn cluster nodes as containers
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    },
    // kubectl + helm CLI
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "none"
    }
  },

  // Split so Codespaces prebuilds can cache the expensive half: prebuilds run up
  // to updateContentCommand and explicitly skip postCreateCommand.
  //   onCreateCommand   → static artifacts (kind binary, node image)  — prebuilt
  //   postCreateCommand → live state (kind cluster, .env)             — per-launch
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Only ports with a matching kind extraPortMapping are listed — see
  // scripts/create-kind-cluster.sh. Prometheus and Tempo have no NodePort and
  // are reachable only via `kubectl port-forward`.
  "forwardPorts": [8000, 9090, 3000],
  "portsAttributes": {
    "8000": { "label": "FrontDesk AI",           "onAutoForward": "openBrowser" },
    "9090": { "label": "FrontDesk AI metrics",   "onAutoForward": "silent" },
    "3000": { "label": "Grafana",                "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // Python
        "ms-python.python",
        "ms-python.vscode-pylance",
        // Kubernetes + Docker
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-azuretools.vscode-docker",
        // YAML / shell / env files
        "redhat.vscode-yaml",
        "timonwong.shellcheck",
        "mikestead.dotenv",
        // Jinja2 templates (templates/login.html)
        "samuelcolvin.jinjahtml",
        // SQLite viewer (history.db, frontdesk_tools.db, checkpoints.db)
        "mtxr.sqliteviewer",
        // API testing
        "rangav.vscode-thunder-client",
        // Git
        "eamodio.gitlens"
      ],
      "settings": {
        // setup.sh installs into the image's system Python — there is no venv here
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "remoteEnv": {
    "SQLITE_DIR": "/shared/.sqlite"
  }
}
