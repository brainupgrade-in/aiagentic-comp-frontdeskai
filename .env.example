# =============================================================
#  FrontDesk AI — Environment Variables
# =============================================================
#  Copy this file:  cp .env.example .env
#  Fill in at least one LLM key below, then run:
#      bash scripts/quickstart.sh
# =============================================================

# -----------------------------------------------------------
# Ollama Cloud (api.ollama.com) — Primary LLM
# Default model: gemma4:cloud (changeable at runtime via admin chat)
# Sign up: https://ollama.com
# -----------------------------------------------------------
OLLAMA_API_KEY=

# -----------------------------------------------------------
# Groq API — Fallback LLM (recommended)
# Used automatically when Ollama Cloud rate-limits or errors.
# Free tier: 30 req/min, 14,400 req/day
# Sign up: https://console.groq.com
# -----------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------
# App settings
# -----------------------------------------------------------
# Shared password for each user's first login (then hashed per user)
AUTH_PASSWORD=brainupgrade

# Comma-separated admin emails — required for the skill_admin scenarios
ADMIN_EMAILS=admin@unigps.in

# Pre-populate 10 employees, leave balances, tickets, expenses, rooms and
# payslips on startup. The Kubernetes path already sets this in
# scripts/manifests/deployment.yaml; keep it here so a direct
# `python app/app.py` run gets the same demo data. The seed is idempotent.
SEED_DEMO_DATA=true

# -----------------------------------------------------------
# LangFuse — LLM prompt/completion/cost tracing (optional)
# All three must be set or tracing stays disabled. The host is region-specific,
# and each region has its own UI and its own keys:
#   https://us.cloud.langfuse.com   (US)
#   https://cloud.langfuse.com      (EU)
# Keys reach the cluster through the K8s secret, so rerun scripts/deploy.sh
# (or scripts/update-secret.sh) after editing them.
# -----------------------------------------------------------
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# -----------------------------------------------------------
# OpenTelemetry — keep this as 'frontdeskai': the Grafana dashboards, PromQL
# examples and Tempo queries in observability.md all filter on this name.
# -----------------------------------------------------------
OTEL_SERVICE_NAME=frontdeskai
