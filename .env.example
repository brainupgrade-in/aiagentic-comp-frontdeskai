# =============================================================
#  FrontDesk AI — Environment Variables
# =============================================================
#  Copy this file:  cp .env.example .env
#  Then fill in your API keys below.
# =============================================================

# -----------------------------------------------------------
# Ollama Cloud (api.ollama.com) — Primary LLM (required)
# Model: llama3.3:70b
# Sign up: https://ollama.com
# -----------------------------------------------------------
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://api.ollama.com/v1

# -----------------------------------------------------------
# Groq API — Fallback LLM (recommended)
# Used automatically when Ollama hits rate limits or errors.
# Free tier: 30 req/min, 14,400 req/day
# Sign up: https://console.groq.com
# -----------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------
# LangFuse — Observability & tracing (optional)
# Sign up: https://cloud.langfuse.com
# -----------------------------------------------------------
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------
# OpenTelemetry — Service name for traces/metrics
# -----------------------------------------------------------
OTEL_SERVICE_NAME=agent-api

# -----------------------------------------------------------
# Ollama Local (Day 1 only) — Local LLM, no API key needed
# -----------------------------------------------------------
OLLAMA_HOST=http://localhost:11434

# -----------------------------------------------------------
# App settings
# -----------------------------------------------------------
SQLITE_DIR=./data/.sqlite
AUTH_PASSWORD=brainupgrade
